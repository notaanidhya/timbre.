# web
web/node_modules/
web/dist/
web/*.tsbuildinfo
# wasm-pack build output (keep pre-built pkg checked in so Vercel can build without Rust toolchain)
!web/crates/timbre_kit/pkg/
!web/crates/timbre_kit/pkg/*
# rust
web/crates/*/target/
target/

# api build artifacts live under api/.gitignore (generated by phx.new)

# local sqlite database (dev/test) — keep the dir, ignore the files
api/.tmp/*
!api/.tmp/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# nix / direnv
.direnv/
.nix-mix/
.nix-hex/
result
result-*

# environment and secrets
.env
.env.*
*.env
api/.env*

# temporary / scratch audio recordings
*.wav
*.webm
*.ogg
*.mp3

# editor, OS, and logs
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.swp
*.swo
*~
erl_crash.dump

# deployment artifacts
.vercel/
api/priv/static/cache_manifest.json

# local certs
api/priv/cert/

